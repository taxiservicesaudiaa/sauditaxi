// Committed so the Cloudflare build stops relying on `wrangler deploy`'s
// automatic Next.js setup. That auto-setup runs `@opennextjs/cloudflare migrate`
// on every deploy, which (in CI, unable to create an R2 bucket) generated a
// config with the incremental cache disabled — every request was a cache MISS
// and a full server render on the Worker, causing the 1102 resource-limit
// errors. This mirrors what that auto-setup generated (same Worker name and
// bindings, minus the never-created R2 bucket); caching is configured in
// open-next.config.ts instead.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "sauditaxi",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding — must match the Worker name above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "sauditaxi"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		// Next's ResponseCache (minimal mode, as OpenNext runs it) keeps up to 150
		// rendered responses in memory per Worker instance, and an entry expires
		// only when the same URL is requested again — so a crawl of distinct URLs
		// retains the last 150 full pages (~350 KB+ each). Inside the 128 MB Worker
		// memory cap that made instances fail with 1102 after a few hundred
		// distinct pages. The cache only dedupes requests within a 10 s window, so
		// a small size loses nothing. Read at module load from process.env, which
		// nodejs_compat populates from these vars before any module code runs.
		"NEXT_PRIVATE_RESPONSE_CACHE_MAX_SIZE": "10",
		// Email (lib/email.ts sends nothing unless RESEND_API_KEY and FROM_EMAIL
		// are both set; the lead notification also needs ADMIN_EMAIL). FROM_EMAIL
		// must be "address" or "Name <address>" on the domain verified in Resend —
		// Resend rejects a bare "<address>". RESEND_API_KEY stays a dashboard secret.
		"FROM_EMAIL": "Saudi Private Transfers <bookings@saudiprivatetransfers.com>",
		"ADMIN_EMAIL": "taxiservicesaudiaa@gmail.com"
	},
	// Environment variables and secrets are managed in the Cloudflare dashboard,
	// not here — keep_vars stops a deploy from removing dashboard-set variables.
	"keep_vars": true
}
